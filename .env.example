# Settings for the server side of Palimpsest (only needed when NEXT_PUBLIC_DATA_BACKEND=server).
# Copy this file to .env.local for development and fill it in; on Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values, never paste them in a chat.

# The Postgres connection string (Supabase: Project Settings > Database > Connection string, the pooled one).
# Supabase needs SSL, so keep ?sslmode=require on the end.
DATABASE_URL=

# The project's address and its public "anon" key (Supabase: Project Settings > API). The key is only used to
# ask Supabase who a sign-in token belongs to; it can read nothing in the poems table (see db/supabase.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Development and tests only: lets a request sign in with a made-up token ("test-user:<a uuid>") instead of
# Supabase. The server refuses to start with this set in production. Leave it unset everywhere else.
# PALIMPSEST_TEST_AUTH=1
