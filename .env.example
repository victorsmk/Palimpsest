# Settings for keeping poems on the server (only needed when NEXT_PUBLIC_DATA_BACKEND=server).
#
# The NEXT_PUBLIC_ ones are put into the page when the app is BUILT and are public by design: set them before
# building (on Vercel: Environment Variables, for Production). The others are read by the server at run time.

# Where poems are kept: "browser" (the default: this browser's storage, no accounts) or "server".
NEXT_PUBLIC_DATA_BACKEND=browser

# The project's address and public key again, for the sign-in in the browser (same values as below).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: lets people sign in with Google (a "Continue with Google" button). The Client ID of the OAuth client
# made in Google Cloud Console (see DEPLOYMENT.md, part 2b). Public. Leave it out and there is no Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server side:
# Copy this file to .env.local for development and fill it in; on Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values, never paste them in a chat.

# The Postgres connection string (Supabase: Project Settings > Database > Connection string, the pooled one).
# Supabase needs SSL, so keep ?sslmode=require on the end.
DATABASE_URL=

# The project's address and its public "anon" key (Supabase: Project Settings > API). The key is only used to
# ask Supabase who a sign-in token belongs to; it can read nothing in the poems table (see db/supabase.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Development and tests only: lets a request sign in with a made-up token ("test-user:<a uuid>") instead of
# Supabase. The server refuses to start with this set in production. Leave it unset everywhere else.
# PALIMPSEST_TEST_AUTH=1

# The project's SECRET key (Supabase: Project Settings > API, "service_role"). Only needed to let people delete
# their account. It can do anything to the project: keep it on the server only (never in a NEXT_PUBLIC_ setting).
SUPABASE_SERVICE_ROLE_KEY=
